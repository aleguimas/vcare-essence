# ─── VCare Essence — variáveis de ambiente ───────────────────────────────────
# Copie para .env.local (dev) e configure no painel da Vercel (produção).
# Todas são OPCIONAIS: sem elas o site funciona, degradando graciosamente
# (analytics off, formulários logam em vez de enviar, calendário mostra "em breve").

# ─── Formulários (Resend) ────────────────────────────────────────────────────
# Sem RESEND_API_KEY, as rotas /api/candidatura e /api/reserva-sala apenas
# validam e logam — não enviam email.
RESEND_API_KEY=
CANDIDATURA_EMAIL_TO=contato@vcareessence.com.br
RESERVA_EMAIL_TO=contato@vcareessence.com.br

# ─── Analytics (carregam só após consentimento de cookies) ───────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ─── Agendamento (Cal.com) ───────────────────────────────────────────────────
# Username da conta Cal.com. Sem isso, o segmentador mostra "em breve" no lugar
# do calendário. Os event-types esperados (ver lib/routes.ts CAL_LINKS):
#   primeiro-encontro-metodo-v, conversa-inicial-metodo-c, psicoterapia-camila,
#   hipnoterapia-vanessa, teste-vocacional-camila, orientacao-familiar-camila
NEXT_PUBLIC_CALCOM_USERNAME=

# ─── CMS Sanity (Diário — desabilitado por ora, documentado para o futuro) ───
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# ─── NOTA ────────────────────────────────────────────────────────────────────
# WhatsApp, telefone, e-mail, Instagram e CRPs NÃO são variáveis de ambiente
# — ficam em lib/routes.ts (constante SITE). Preencher lá quando confirmados.
